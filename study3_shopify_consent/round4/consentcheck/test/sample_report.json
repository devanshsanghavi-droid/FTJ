 "fixes": [
  {
   "id": "region_default",
   "title": "Make Shopify's default match your banner",
   "steps": [
    "In Shopify admin, go to Settings > Customer privacy and review the cookie banner / consent settings for the regions where your banner asks visitors to choose.",
    "If visitors there should be asked before tracking, set those regions so that tracking requires consent; Shopify then holds marketing pixels until the visitor accepts.",
    "Keep only one banner: if you use a third-party consent app, Shopify recommends disabling its own banner."
   ],
   "links": [
    "https://help.shopify.com/en/manual/privacy-and-security/privacy/customer-privacy-settings/privacy-settings"
   ]
  },
  {
   "id": "cpapi_initial",
   "title": "Have your consent app report the initial state before pixels start",
   "steps": [
    "Ask your consent app vendor whether it reports \"no\" (or \"not yet\") to Shopify as soon as the page starts, for visitors who have not chosen.",
    "Where it cannot, rely on Shopify's own region setting (next fix) so that pixels wait by default."
   ],
   "links": [
    "https://shopify.dev/docs/api/customer-privacy"
   ]
  },
  {
   "id": "custom_purposes",
   "title": "Set a privacy purpose on every custom pixel",
   "steps": [
    "In Shopify admin, go to Settings > Customer events and open the Custom pixels tab.",
    "Open each pixel listed above as declaring no purpose, find Customer privacy > Permission, choose \"Required\" and tick the purposes the pixel serves (Marketing for ad pixels; Analytics for measurement).",
    "Under Customer privacy > Data sale, keep \"qualifies as data sale\" for advertising pixels (this is the default for new custom pixels), then save."
   ],
   "links": [
    "https://help.shopify.com/en/manual/promoting-marketing/pixels/custom-pixels/manage",
    "https://help.shopify.com/en/manual/promoting-marketing/pixels/custom-pixels/code"
   ]
  },
  {
   "id": "custom_data_sale",
   "title": "Mark ad custom pixels as \"data sale\"",
   "steps": [
    "In Settings > Customer events > Custom pixels, open each advertising pixel listed above.",
    "Under Customer privacy > Data sale, choose the option saying the data collected qualifies as data sale, then save. Shopify then stops the pixel for visitors who opted out, including by GPC."
   ],
   "links": [
    "https://help.shopify.com/en/manual/promoting-marketing/pixels/custom-pixels/code"
   ]
  },
  {
   "id": "app_purposes",
   "title": "Ask app developers about purposes (you cannot edit them yourself)",
   "steps": [
    "An app pixel's privacy purposes are set by the app developer. Contact the developer of each app pixel listed above and ask it to declare marketing and data sale for advertising data.",
    "Check whether the app has its own consent settings (for example consent mode or limited data use), and turn them on.",
    "If an advertising app cannot declare its purposes, consider replacing it with a custom pixel whose purposes you control, or removing it."
   ],
   "links": [
    "https://help.shopify.com/en/manual/promoting-marketing/pixels/app-pixels",
    "https://shopify.dev/docs/api/web-pixels-api/pixel-privacy"
   ]
  },
  {
   "id": "no_script_blocking",
   "title": "Don't rely on script blocking for app and custom pixels",
   "steps": [
    "Your consent app's auto-blocking or blocklist only reaches scripts in the main page. App and custom pixels run in Shopify's sandbox (a web worker or hidden iframe) and are controlled only by Shopify's consent state.",
    "Keep the blocklist for theme scripts, but make sure the Shopify integration and pixel purposes (above) are right, because that is what controls the sandbox."
   ],
   "links": [
    "https://shopify.dev/docs/apps/build/marketing-analytics/pixels"
   ]
  }
