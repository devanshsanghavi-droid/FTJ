 "first_party_rules": [
  {
   "id": "G1",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET",
   "path_regex": "/gtm\\.js$",
   "query_regex": "(^|&)id=GTM-[A-Z0-9]+",
   "attributes_to": "google_tagmanager",
   "kind": "library",
   "evidence": "strong",
   "note": "Google Tag Manager container served from the site (sGTM web-container client or Google tag gateway)"
  },
  {
   "id": "G2",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET",
   "path_regex": "/gtag/js$",
   "query_regex": "(^|&)id=(G|AW|DC|GT)-[A-Z0-9]+",
   "attributes_to": "google_tagmanager",
   "kind": "library",
   "evidence": "strong",
   "note": "Google tag (gtag.js) served first-party"
  },
  {
   "id": "G3",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET",
   "path_regex": "\\.js$",
   "query_regex": "(aWQ9R1RNL|aWQ9Ry0|aWQ9QVct)",
   "attributes_to": "google_tagmanager",
   "kind": "library",
   "evidence": "moderate",
   "note": "custom loader: base64 of \"id=GTM-\", \"id=G-\" or \"id=AW-\" in the query (e.g. Stape custom loader)"
  },
  {
   "id": "G4",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET|POST",
   "path_regex": "(^|/)g/collect$",
   "query_regex": "(^|&)v=2(&|$).*(^|&)tid=G-|(^|&)tid=G-.*(^|&)v=2(&|$)",
   "attributes_to": "google_analytics",
   "kind": "beacon",
   "evidence": "strong",
   "note": "GA4 hit to a first-party collection path; may be forwarded server-side to GA4 and other vendors"
  },
  {
   "id": "G5",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET|POST",
   "path_regex": null,
   "query_or_body_regex": "(^|&)v=2&.*tid=G-[A-Z0-9]+.*(^|&)en=",
   "attributes_to": "google_analytics",
   "kind": "beacon",
   "evidence": "strong",
   "note": "GA4 wire format on any first-party path (sGTM GA4 client with a custom path)"
  },
  {
   "id": "G6",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET|POST",
   "path_regex": "(^|/)(ccm/collect|pagead/(1p-)?conversion|pagead/viewthroughconversion|pagead/1p-user-list|pagead/landing|rmkt/collect)(/|$)",
   "attributes_to": "google_ads",
   "kind": "beacon",
   "evidence": "strong",
   "note": "Google Ads conversion / remarketing / ccm hit on a first-party path"
  },
  {
   "id": "G7",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET|POST",
   "path_regex": "(^|/)(j/)?collect$",
   "query_regex": "(^|&)v=1&.*tid=UA-",
   "attributes_to": "google_analytics",
   "kind": "beacon",
   "evidence": "strong",
   "note": "legacy Universal Analytics wire format"
  },
  {
   "id": "G8",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET|POST",
   "path_regex": null,
   "query_regex": "(^|&)gtm=4[0-9a-z]+.*(^|&)(gcs|gcd)=|(^|&)(gcs|gcd)=.*(^|&)gtm=4[0-9a-z]+",
   "attributes_to": "google_tag_unknown",
   "kind": "beacon",
   "evidence": "moderate",
   "note": "Google tag hit parameters (gtm= container hash plus consent parameters) on an unrecognised path"
  },
  {
   "id": "G9",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "POST",
   "path_regex": "(^|/)data/?$",
   "body_regex": "\"?event_name\"?\\s*[:=]",
   "attributes_to": "sgtm_data_client",
   "kind": "beacon",
   "evidence": "moderate",
   "note": "server-side GTM \"Data client\" (e.g. Stape Data Tag) event stream; vendor fan-out is server-side"
  },
  {
   "id": "G10",
   "architecture": "gateway",
   "scope": "same_site_subdomain",
   "host_regex": "^capig\\.",
   "method": "GET|POST",
   "path_regex": null,
   "attributes_to": "meta",
   "kind": "beacon",
   "evidence": "moderate",
