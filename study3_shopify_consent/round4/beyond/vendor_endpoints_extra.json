  },
  {
   "id": "G11",
   "architecture": "gateway",
   "scope": "same_site_or_known_gateway_host",
   "method": "GET|POST",
   "path_regex": "(^|/)tr/?$",
   "query_regex": "(^|&)id=\\d{6,}.*(^|&)ev=|(^|&)ev=.*(^|&)id=\\d{6,}",
   "attributes_to": "meta",
