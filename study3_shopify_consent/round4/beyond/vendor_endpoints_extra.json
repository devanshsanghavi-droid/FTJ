 "consent_signal_decoders": {
  "google_gcs": {
   "param": "gcs",
   "regex": "^G1([01-])([01-])$",
   "fields": [
    "ad_storage",
    "analytics_storage"
   ],
   "values": {
    "1": "granted",
    "0": "denied",
    "-": "not_set"
   },
   "source": "Google consent mode documentation (gcs values G100/G110/G101/G111)"
  },
  "google_gcd": {
   "param": "gcd",
   "positions": {
    "ad_storage": 2,
    "analytics_storage": 4,
    "ad_user_data": 6,
    "ad_personalization": 8
   },
   "letters": {
    "l": "not_set",
    "p": "denied_default",
    "q": "denied_default_and_update",
    "t": "granted_default",
    "r": "granted_by_update_after_denied_default",
    "m": "denied_by_update",
    "n": "granted_by_update",
    "u": "denied_by_update_after_granted_default",
    "v": "granted_default_and_update"
   },
   "effective_granted": [
    "t",
    "r",
    "n",
    "v"
   ],
   "effective_denied": [
    "p",
    "q",
    "m",
    "u"
   ],
   "source": "practitioner decoding of the undocumented gcd parameter; verify on calibration pages before relying on it"
  },
  "google_other": {
   "params": [
    "npa",
    "dma",
    "dma_cps",
    "pscdl",
    "gcu",
    "gcut"
   ],
   "note": "npa=1 non-personalised ads; dma = EEA DMA flag; record raw values"
  },
  "zaraz_consent": {
   "cookie": "cf_consent",
   "note": "name configurable; value maps purpose IDs to true/false (missing = no choice yet). Read zaraz.consent.getAll() in the page as the primary signal."
  },
  "wix_consent_policy": {
   "api": "window.consentPolicyManager.getCurrentConsentPolicy() -> {defaultPolicy, policy:{essential,functional,analytics,advertising,dataToThirdParty}}",
   "cookie": "consent-policy",
   "cookie_note": "URL-encoded JSON; short keys expected (ess/func/anl/adv/dt3); calibrate on first pilot loads",
   "static": "viewer model \"siteConsentPolicy\" = site default for this visitor region (screening)"
  },
  "bigcommerce_consent": {
   "api": "window.consentManagerStoreConfig()",
   "dom": "script[type=\"text/plain\"][data-bc-cookie-consent] = scripts held back per category",
   "categories": {
    "1": "essential",
    "2": "functional",
    "3": "analytics",
    "4": "targeting"
   },
   "cookie": "record all first-party cookie names matching /consent/i at each checkpoint; name to be confirmed on calibration loads"
  },
  "tcf_gpp": {
   "api": [
    "__tcfapi(\"getTCData\")",
    "__gpp(\"ping\")"
   ],
   "note": "as in Part A probes"
  }
 },
